# Local development only. Never copy RDS credentials into this file.
POSTGRES_DB=rachata_plus
POSTGRES_USER=rachata
POSTGRES_PASSWORD=rachata_local_dev
POSTGRES_PORT=15432
DB_HOST=127.0.0.1
DB_SSLMODE=disable
HTTP_ADDR=127.0.0.1:8080
AUTH_ORIGIN=http://127.0.0.1:5174
COOKIE_SECURE=false
LOCAL_VIDEO_ENABLED=true
MEDIA_DIR=../../storage
# Native go run uses embedded/direct. compose.runtime.yaml overrides these.
APP_ENV=local
APP_MODE=api
VIDEO_WORKER_MODE=embedded
MEDIA_DELIVERY=direct
FFMPEG_THREADS=2
WEB_PORT=8088

# Shared source + HLS storage budgets (API and worker must match)
MEDIA_TOTAL_BYTES=10737418240
MEDIA_JOB_BYTES=1073741824
MEDIA_MIN_FREE_BYTES=536870912
