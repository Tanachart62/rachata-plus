# Template only. bootstrap.py writes the real file from Secrets Manager.
APP_ENV=production
AUTH_ORIGIN=https://video.example.com
COOKIE_SECURE=true
HTTP_ADDR=0.0.0.0:8080
DB_HOST=replace-with-rds-endpoint
POSTGRES_PORT=5432
POSTGRES_DB=rachata_plus
POSTGRES_USER=rachata
POSTGRES_PASSWORD=replace-locally-never-commit
DB_SSLMODE=verify-full
DB_SSLROOTCERT=/run/secrets/rds-ca.pem
DB_MAX_CONNS=10
AWS_REGION=us-east-1
MEDIA_BACKEND=s3
S3_BUCKET=replace-with-bucket
S3_PREFIX=media
LOCAL_VIDEO_ENABLED=true
VIDEO_WORKER_MODE=external
MEDIA_DELIVERY=direct
MEDIA_DIR=/srv/media
# Scratch budget for source plus all renditions, not an S3 quota.
MEDIA_JOB_BYTES=21474836480
MEDIA_TOTAL_BYTES=42949672960
MEDIA_MIN_FREE_BYTES=2147483648
FFMPEG_THREADS=2
VIDEO_JOB_TIMEOUT=6h
TRUSTED_PROXY_CIDRS=172.30.84.0/24
GIN_MODE=release
